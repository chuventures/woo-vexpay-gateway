#: includes/class-vexpay-gateway.php:21
msgid "Accept Venezuela Débito inmediato payments via VEXPay (bank OTP)."
msgstr "Acepta pagos de Débito inmediato de Venezuela a través de VEXPay (OTP bancario)."

#: includes/class-vexpay-gateway.php:31
msgid "Pay from your bank account with an SMS OTP."
msgstr "Paga desde tu cuenta bancaria con un OTP por SMS."

#: includes/class-vexpay-gateway.php:69
msgid "VEXPay: Sandbox is off, but the Live API key looks like a Test twin (vk_test_…). Débito OTP will stay simulated with no bank SMS. Paste your Live twin key (vk_live_…) into Live API key, save, then retry."
msgstr "VEXPay: el Sandbox está desactivado, pero la clave API Live parece una clave de prueba (vk_test_…). El OTP de Débito seguirá simulado sin SMS bancario. Pega tu clave Live (vk_live_…) en Clave API Live, guarda y vuelve a intentarlo."

#: includes/class-vexpay-gateway.php:87
#: includes/class-vexpay-gateway.php:160
msgid "Pay from your bank account with an SMS OTP from your bank."
msgstr "Paga desde tu cuenta bancaria con un OTP por SMS de tu banco."

#: includes/class-vexpay-gateway.php:144
msgid "Enable/Disable"
msgstr "Activar/Desactivar"

#: includes/class-vexpay-gateway.php:146
msgid "Enable VEXPay Débito inmediato"
msgstr "Activar VEXPay Débito inmediato"

#: includes/class-vexpay-gateway.php:150
msgid "Title"
msgstr "Título"

#: includes/class-vexpay-gateway.php:152
msgid "Payment method title at checkout."
msgstr "Título del método de pago en el checkout."

#: includes/class-vexpay-gateway.php:157
msgid "Description"
msgstr "Descripción"

#: includes/class-vexpay-gateway.php:159
msgid "Shown under the payment method at checkout."
msgstr "Se muestra debajo del método de pago en el checkout."

#: includes/class-vexpay-gateway.php:163
msgid "Sandbox"
msgstr "Sandbox"

#: includes/class-vexpay-gateway.php:166
msgid "When on, use the Sandbox (Test twin) API key. Débito OTP is simulated — no bank SMS; use Portal → Sandbox. Turn off and paste a Live twin key for real bank SMS."
msgstr "Cuando está activo, usa la clave API de Sandbox (prueba). El OTP de Débito se simula — sin SMS bancario; usa Portal → Sandbox. Desactívalo y pega una clave Live para SMS bancarios reales."

#: includes/class-vexpay-gateway.php:169
msgid "Live API key"
msgstr "Clave API Live"

#: includes/class-vexpay-gateway.php:172
msgid "Live twin x-api-key from the VEXPay dashboard (usually starts with vk_live_). Required for real bank OTP SMS."
msgstr "Clave x-api-key Live del panel de VEXPay (suele empezar con vk_live_). Necesaria para SMS OTP bancarios reales."

#: includes/class-vexpay-gateway.php:176
msgid "Sandbox API key"
msgstr "Clave API Sandbox"

#: includes/class-vexpay-gateway.php:179
msgid "Test twin x-api-key from the VEXPay dashboard (usually starts with vk_test_). Débito OTP is simulated — no SMS."
msgstr "Clave x-api-key de prueba del panel de VEXPay (suele empezar con vk_test_). El OTP de Débito se simula — sin SMS."

#: includes/class-vexpay-gateway.php:183
msgid "Connection"
msgstr "Conexión"

#: includes/class-vexpay-gateway.php:185
msgid "Verify that this WordPress site can reach VEXPay with the API key for the mode selected above. Paste the key, then click Test — you can test before saving."
msgstr "Verifica que este sitio de WordPress pueda conectar con VEXPay usando la clave API del modo seleccionado arriba. Pega la clave y haz clic en Probar — puedes probar antes de guardar."

#: includes/class-vexpay-gateway.php:188
msgid "Webhook secret"
msgstr "Secreto del webhook"

#: includes/class-vexpay-gateway.php:190
msgid "HMAC secret for X-Webhook-Signature. Filled automatically when the plugin registers a webhook on a public URL, or paste from the VEXPay dashboard. Localhost is skipped (use a tunnel)."
msgstr "Secreto HMAC para X-Webhook-Signature. Se completa automáticamente cuando el plugin registra un webhook en una URL pública, o pégalo desde el panel de VEXPay. Localhost se omite (usa un túnel)."

#: includes/class-vexpay-gateway.php:194
msgid "Webhook endpoint ID"
msgstr "ID del endpoint del webhook"

#: includes/class-vexpay-gateway.php:196
msgid "Stored after automatic registration. Leave blank to re-register on save."
msgstr "Se guarda tras el registro automático. Déjalo en blanco para volver a registrar al guardar."

#: includes/class-vexpay-gateway.php:200
msgid "Show VES estimate"
msgstr "Mostrar estimado en VES"

#: includes/class-vexpay-gateway.php:202
msgid "Display BCV VES amount at checkout (display only)"
msgstr "Mostrar el monto en VES (BCV) en el checkout (solo informativo)"

#: includes/class-vexpay-gateway.php:206
msgid "Debug log"
msgstr "Registro de depuración"

#: includes/class-vexpay-gateway.php:208
msgid "Enable logging"
msgstr "Activar registro"

#. translators: %s: WooCommerce logs URL path hint
#: includes/class-vexpay-gateway.php:212
msgid "Logs appear under WooCommerce → Status → Logs (source: vexpay). Never log API keys."
msgstr "Los registros aparecen en WooCommerce → Estado → Registros (origen: vexpay). Nunca registres claves API."

#: includes/class-vexpay-gateway.php:356
msgid "Test connection"
msgstr "Probar conexión"

#: includes/class-vexpay-gateway.php:455
msgid "Testing…"
msgstr "Probando…"

#: includes/class-vexpay-gateway.php:456
msgid "Connection failed."
msgstr "La conexión falló."

#: includes/class-vexpay-gateway.php:468
